# Sovereign environment configuration. Copy to .env and adjust.
#
# A single .env at the repo root configures the whole monorepo. Each Next app
# loads it via `loadEnvConfig(repoRoot)` in its next.config.ts — no per-app
# .env files needed. (More variables land with the runtime/deploy tasks.)

# --- Auth server (apps/auth) ---
# AUTH_SECRET has no default — the auth server refuses to start without it.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# When true, registration requires a valid invite (the first user is exempt).
AUTH_INVITE_ONLY=false
# When true (default), a new account must click an emailed verification link
# before signing in. Set to false for air-gapped/internal deployments where
# the invite mechanism itself is sufficient proof of identity. Existing
# accounts from before this was enabled are grandfathered automatically —
# only new registrations go through the email flow.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Public base URL of the auth server. Set to your domain in production
# (e.g. https://auth.example.com, or https://example.com if auth and runtime
# share a domain). Used by better-auth for callback construction and CSRF origin
# validation. Leave unset for local dev — defaults to http://localhost:${AUTH_PORT:-3001}.
# !! REQUIRED for production — see NEXT_PUBLIC_RUNTIME_URL note below !!
# AUTH_BASE_URL=http://localhost:3001
# Comma-separated list of origins trusted for server-to-server CSRF checks, in
# addition to AUTH_BASE_URL. Set this to the internal Docker service address
# (http://auth:3001) when AUTH_BASE_URL is your public domain, so runtime→auth
# API calls (avatar upload, password change, etc.) are accepted. Not needed for
# native dev (both use localhost:${AUTH_PORT:-3001}).
# !! REQUIRED for production with Docker Compose !!
# AUTH_TRUSTED_ORIGINS=http://auth:3001
# Cookie domain for cross-subdomain session sharing. Required when auth and
# runtime are on different subdomains (e.g. auth.example.com + example.com).
# Set to the shared parent domain with a leading dot: .example.com
# Leave unset for local dev (both on localhost).
# !! REQUIRED for production split-subdomain deployments !!
# AUTH_COOKIE_DOMAIN=.example.com
# WebAuthn / passkeys (RFC 0012). These only matter if you enable passkeys.
# The defaults work for localhost development. For production, set them to
# your actual domain and origins.
# AUTH_WEBAUTHN_RP_ID=localhost
# AUTH_WEBAUTHN_RP_NAME=Sovereign
# Comma-separated list of allowed WebAuthn origins. Must include the runtime
# origin because passkey sign-in and management go through the runtime proxy.
# Keep the auth server public origin included while compatibility routes remain
# exposed. Defaults to the localhost ports automatically; in production set to e.g.:
#   AUTH_WEBAUTHN_ORIGIN=https://example.com,https://auth.example.com
# AUTH_WEBAUTHN_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Runtime (runtime/) ---
# Where the runtime reaches the auth server (server-to-server, e.g. /api/verify)
# and the browser-facing runtime URL used in auth emails/compatibility pages.
#
# Leave both UNSET for local use: native `pnpm dev` derives localhost URLs from
# RUNTIME_PORT / AUTH_PORT, and the Compose files inject the right values per
# environment (dev → :3000/:3001, prod → :4000/:4001 on the host). Setting them
# here would override those per-environment defaults for ALL environments at once.
#
# !! REQUIRED for production (VPS / server deployments) !!
# Without these, post-login redirects go to localhost:* which the remote browser
# cannot reach — causing a login loop.
#
# Set AUTH_BASE_URL (in the Auth section above) to the public-facing auth URL,
# then set NEXT_PUBLIC_RUNTIME_URL here to the public-facing runtime URL.
# Example with IP:     NEXT_PUBLIC_RUNTIME_URL=http://203.0.113.10:4000
# Example with domain: NEXT_PUBLIC_RUNTIME_URL=https://example.com
#
# SOVEREIGN_AUTH_URL stays the internal Docker address (set by Compose automatically).
# SOVEREIGN_AUTH_URL=http://localhost:3001
# NEXT_PUBLIC_RUNTIME_URL=http://localhost:3000
# Where the auth server reaches the runtime for server-to-server calls (e.g.
# recording email-delivery-failure activity log entries). The reverse of
# SOVEREIGN_AUTH_URL. Docker Compose sets it to the internal service name
# (http://runtime:3000) automatically — only set it for non-Docker/native runs
# where the auth server needs to reach a non-default runtime port.
# SOVEREIGN_RUNTIME_URL=http://localhost:3000
# Shared secret for runtime→auth admin API calls (Console user management).
# No default — the auth server and runtime both refuse to start without it.
# Generate one with:  openssl rand -base64 32
SOVEREIGN_ADMIN_KEY=
# Secret for local session verification (SRS AUTH-05). The runtime verifies the
# auth server's signed session cookie offline using this secret — no /api/verify
# round-trip per request — falling back to /api/verify when absent. It MUST equal
# the auth server's signing secret, so it defaults to AUTH_SECRET above; set it
# only if you deliberately run a distinct value.
# SOVEREIGN_AUTH_SECRET=

# Platform-managed plugin secret vault key (RFC 0043). Required before plugins
# can create/read runtime secrets through sdk.secrets, and before a Console-
# managed SMTP password (Console -> Settings -> Email delivery) can be saved
# or decrypted. No default; generate with:
#   openssl rand -base64 32
# Set the same value for both the runtime and auth services (each decrypts
# its own local copy independently).
# Required in practice for the bundled Plainwrite plugin's GitHub PAT flow —
# without it, connecting a site fails at "Connect using a token" with:
#   SOVEREIGN_VAULT_KEY is required before sdk.secrets can store or read secret values.
# SOVEREIGN_VAULT_KEY=

# App-level field encryption (RFC 0092) — both unset by default; the platform
# behaves exactly as before until you opt in.
#
# SOVEREIGN_ENCRYPT_CLASSES is the operator policy: a comma-separated list of
# sensitivity classes to encrypt (e.g. pii,health). Fields whose class is not
# listed stay plaintext. Enabling a class affects NEW writes only — existing
# rows are converted by the explicit `sv db encrypt-fields` backfill tool,
# never automatically. See docs/self-hosting.md "Field encryption".
#
# SOVEREIGN_FIELD_KEK is the master key wrapping the per-plugin data keys.
# Required whenever SOVEREIGN_ENCRYPT_CLASSES is non-empty (startup fails
# loudly otherwise). Deliberately a different key than SOVEREIGN_VAULT_KEY.
# No default; generate with:
#   openssl rand -base64 32
# Rotate with `sv keys rotate-field-kek` (rewraps keys only, never data).
# Runtime service only — the auth service does not read either variable.
# SOVEREIGN_ENCRYPT_CLASSES=
# SOVEREIGN_FIELD_KEK=

# --- Diagnostics & dev-mode (RFC 0020) ---
# Structured logging level. Logs go to stdout/stderr only — never egresses
# (see docs/security.md). Values: error | warn (default) | info | debug.
# LOG_LEVEL=warn

# Production dev-mode: lets operators exercise features on a live instance
# against a seeded mock database without touching real user data (RFC 0020).
# Off by default — the feature does not exist unless explicitly enabled.
# SOVEREIGN_DEV_MODE_ENABLED=true
#
# Secret that callers must supply in X-Sovereign-Dev-Mode-Secret to activate
# dev-mode on a request. Falls back to SOVEREIGN_ADMIN_KEY when unset. Must
# not have a default — no-secrets-with-defaults rule.
# SOVEREIGN_DEV_MODE_SECRET=
#
# The mock database populated by `sv seed` — dev-mode requests read/write
# only this store, never the real one. Meaning is dialect-dependent: on
# Postgres a full postgres:// connection string (a genuinely separate
# database); on SQLite an sqld namespace name (there's no plain-file path for
# it to be a file: URL to anymore).
# SOVEREIGN_DEV_DATABASE_URL=sovereign_dev
#
# `sv seed`/`scripts/seed.ts` refuses to run when NODE_ENV=production (it
# populates public dev-default credentials). Set to true ONLY to seed a
# disposable test/staging database that happens to run with NODE_ENV=production
# — never against a real instance's data.
# SOVEREIGN_SEED_ALLOW_PROD=true

# --- Database ---
# DB_DIALECT is the sole source of truth — required, no inference, no
# default. SQLite by default in this file (zero-config); every SQLite
# database (platform, auth, every plugin) is sqld-backed, never a plain file.
DB_DIALECT=sqlite

# sqld (libSQL server): the SQLite dialect's actual store.
# - `pnpm dev` (native): scripts/ensure-sqld.ts starts a local sqld container
#   automatically and the defaults below (commented out, shown for
#   reference) already point at it — nothing to set.
# - Docker stack (docker-compose.yml / docker-compose.prod.yml): sqld is
#   part of the base compose file; it sets SQLD_URL/SQLD_ADMIN_URL to the
#   internal service hostname itself, overriding these defaults.
# - Only set these yourself for a remote or otherwise unmanaged sqld
#   instance. See docs/self-hosting.md.
# SQLD_URL=http://localhost:28080
# SQLD_ADMIN_URL=http://localhost:28081

# PostgreSQL: set DB_DIALECT=postgres and POSTGRES_DB_URL to a postgres://
# connection string. auth and the runtime both read this same variable — auth
# gets its own schema (sovereign_auth) within that database, not a separate
# one. With the Docker stack, layer docker-compose.postgres.yml over
# docker-compose.prod.yml (it provisions a postgres service and wires both
# apps to it) — then only POSTGRES_PASSWORD below is required. See
# docs/self-hosting.md.
# POSTGRES_DB_URL=postgres://sovereign:changeme@localhost:5432/sovereign
# POSTGRES_USER=sovereign
# POSTGRES_PASSWORD=
# POSTGRES_DB=sovereign
# Path to a CA PEM file for Postgres TLS certificate verification. Only used
# when POSTGRES_DB_URL includes sslmode=verify-full. Uses the standard libpq
# convention (same as the PGSSLROOTCERT env var in psql/pg_dump).
# PGSSLROOTCERT=/path/to/ca.pem

# --- Plugin file storage (RFC 0044) ---
# Conservative default quotas for sdk.storage.put() — object and per-plugin
# totals in bytes. sdk.storage.put() throws once either would be exceeded.
# Defaults: 25 MiB per object, 500 MiB per plugin.
# SOVEREIGN_STORAGE_MAX_OBJECT_BYTES=26214400
# SOVEREIGN_STORAGE_MAX_PLUGIN_BYTES=524288000

# --- Email (SMTP) ---
# In dev (NODE_ENV != production) the mailer automatically falls back to Mailpit
# on localhost:1025 when SMTP_HOST is unset — no config needed for local dev.
# For Docker Compose dev set SMTP_HOST=mailpit (the service name).
# In production, with SMTP_HOST unset the mailer is a graceful no-op.
#   Docker (app in Compose): SMTP_HOST=mailpit
#   Native / pnpm dev:       (unset — auto-falls back to localhost:1025)
# SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sovereign <noreply@sovereign.local>

# Mailpit host-port overrides (optional; defaults 1025 / 8025)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# --- Docker Compose ---
# Host port the runtime is mapped to. Native `pnpm dev` also uses this port.
# Default in dev (docker-compose.yml):      3000
# Default in prod (docker-compose.prod.yml): 4000
# RUNTIME_PORT=3000
# Host port the auth server is mapped to. Native `pnpm dev` also uses this port.
# Default in dev (docker-compose.yml):      3001
# Default in prod (docker-compose.prod.yml): 4001
# AUTH_PORT=3001

# Browser-facing URL for auth server compatibility routes. In Docker Compose the
# runtime sets SOVEREIGN_AUTH_URL to the internal service name (http://auth:3001),
# which the browser cannot resolve. SOVEREIGN_AUTH_PUBLIC_URL is the host-reachable
# address for direct auth-server browser access; server-side API calls continue to use
# SOVEREIGN_AUTH_URL. Not needed for native dev (defaults to localhost:${AUTH_PORT:-3001}).
# SOVEREIGN_AUTH_PUBLIC_URL=http://localhost:3001

# Note: SOVEREIGN_AUTH_URL above is for native dev (localhost:${AUTH_PORT:-3001}).
# When using Docker Compose, the runtime container overrides this to
# http://auth:3001 (internal Docker network) automatically — do not change
# SOVEREIGN_AUTH_URL for Docker use.

# ── Web Push / VAPID (RFC 0016) ───────────────────────────────────────────────
# Optional. When both keys are set, Sovereign sends background push
# notifications to subscribed browser devices. Leave unset to disable push
# (the in-app bell is the fallback — the app works without push configured).
#
# Generate a VAPID key pair once per deployment with:
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY=<base64url public key>
# VAPID_PRIVATE_KEY=<base64url private key>
# Contact email or URL used in the VAPID Authorization header (required by spec).
# VAPID_CONTACT=mailto:admin@example.com

# ── Sovereign Relay / native mobile push (RFC 0087) ───────────────────────────
# Optional deployment-time override for the relay this instance registers new
# sovereign-mobile device tokens against — sovereignfs's own relay
# (https://relay.sovereign.openfs.io) is used when unset. An admin can also
# override this from Console, which takes precedence over this env var; this
# is only the value new installs start from. Only relevant for an operator
# self-hosting their own apps/relay instance (RFC 0087's "Deployment
# topology" — a real escape hatch for WebRTC signaling, but for push
# specifically it also requires the operator's own Apple/Firebase
# credentials and a separately signed app build, since APNs/FCM tokens are
# permanently bound to the app identity that generated them).
# SOVEREIGN_RELAY_URL=https://relay.sovereign.openfs.io

# The following vars configure apps/relay itself (the shared relay service —
# not something a self-hosted instance's own runtime/auth normally need).
# Only set these if you're running/deploying apps/relay, e.g. sovereignfs's
# own default relay, or an operator self-hosting their own instance under
# RFC 0087's escape hatch. Every capability below silently no-ops (a clear
# "not_configured" response, never a crash) when its vars are unset, the
# same discipline VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY above already use.
#
# HMAC secret the relay signs/verifies its own stateless enrollment tokens
# with (workstream 0005 leg 2) — required for /v1/enroll and /v1/push to
# work at all. Generate one with: openssl rand -base64 32
# RELAY_ENROLLMENT_SECRET=
#
# APNs (iOS) credentials — APNS_KEY/APNS_KEY_ID/APNS_TEAM_ID (the shared JWT
# credential) plus APNS_BUNDLE_ID (iOS's own topic) are all required together
# for iOS push specifically. APNS_KEY is the .p8 key file's content verbatim
# (PEM), not a file path.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# Use Apple's sandbox APNs host instead of production. Only for development.
# APNS_USE_SANDBOX=false
#
# APNs (macOS) — sovereign-desktop's own app identity, additive to the iOS
# vars above (RFC 0087's "Desktop native push" addendum, workstream 0010).
# Same Apple Developer Team and JWT credential as iOS (APNS_KEY/APNS_KEY_ID/
# APNS_TEAM_ID above), distinct bundle ID/topic. Can be set independently of
# APNS_BUNDLE_ID — an operator may enable one platform without the other.
# APNS_BUNDLE_ID_MACOS=
#
# FCM (Android) credentials — the Firebase service-account JSON key file's
# content verbatim (one line, JSON-encoded), not a file path.
# FCM_SERVICE_ACCOUNT_JSON=
#
# WNS (Windows) credentials — Partner Center-issued Package SID (used as the
# OAuth2 client_id) and its client secret (RFC 0087's "Desktop native push"
# addendum). Raw notifications only — see that addendum for why: WNS toast
# notifications could show a banner even while sovereign-desktop is fully
# quit, but only by sending Microsoft plaintext content, which conflicts
# with this relay's content-blind design. Raw notifications stay encrypted
# but only reach a running (tray-resident is enough) process.
# WNS_PACKAGE_SID=
# WNS_CLIENT_SECRET=

# ── Warden's harness engine (RFC 0063, workstream 0014 legs 2-3) ─────────────
# apps/harness wraps llama.cpp server (Research 0015's decision) for Warden's
# basic local chat. Entirely optional — only relevant if you run
# `docker compose --profile harness up` (both apps/harness itself and its
# llama.cpp sidecar are gated behind that profile; the baseline stack is
# unaffected when it's not enabled). Neither is ever exposed to the public
# internet — reachable only from the other (or the runtime) over sovereign_net.
#
# HMAC secret apps/harness signs/verifies its own stateless enrollment
# tokens with (same reused pattern as RELAY_ENROLLMENT_SECRET above) —
# required for /api/enroll and /api/chat to work at all. Generate one with:
# openssl rand -base64 32. Consumed only by apps/harness itself — Warden's
# own server-side code never sees this secret, only the token /api/enroll
# hands back.
# SOVEREIGN_HARNESS_ENROLLMENT_SECRET=
#
# Where the runtime (Warden's server-side code) reaches apps/harness. Default
# is the Compose internal service address; harmless to leave set even when
# the `harness` profile isn't running — Warden's fetch just fails, which is
# exactly the "installed but unreachable" state its UI already handles.
# SOVEREIGN_HARNESS_URL=http://harness:3003
#
# Which model profile to run: qwen3-1.7b (default, RFC 0063 §4's
# recommendation) or qwen3-0.6b (low-resource fallback — meaningfully
# faster on modest self-hosting hardware per Research 0015's benchmark).
# SOVEREIGN_HARNESS_MODEL=qwen3-1.7b
#
# llama.cpp server's context window size (tokens). Lower uses less memory;
# see Research 0015's benchmark notes on this hardware tradeoff.
# SOVEREIGN_HARNESS_CONTEXT_SIZE=8192
#
# Request limits enforced server-side (never left to the client) — see RFC
# 0063 §6. Defaults are conservative, suitable for a small local chat model
# on modest self-hosting hardware.
# SOVEREIGN_HARNESS_MAX_INPUT_CHARS=4000
# SOVEREIGN_HARNESS_MAX_OUTPUT_TOKENS=512
# SOVEREIGN_HARNESS_MAX_RECENT_TURNS=10
# SOVEREIGN_HARNESS_MAX_CONCURRENCY=2
# SOVEREIGN_HARNESS_TIMEOUT_SECONDS=120
#
# Internal-only overrides, not meant for normal operator use:
# SOVEREIGN_HARNESS_LLAMACPP_URL (default http://harness-engine:8080, the
# Compose service address) and SOVEREIGN_HARNESS_ENGINE=fake (deterministic
# canned responses, no real model — CI/tests only, never set this in a real
# deployment).

# ── Notification transport (RFC 0034) ────────────────────────────────────────
# Controls how the bell receives notifications. Default is 'sse' — instant
# in-process delivery, no extra infra, correct for a single runtime process.
# If you run multiple runtime processes/containers (clustered/multi-replica),
# set this to 'redis' instead: 'sse' is in-process only, so a notification
# published on one process never reaches a client connected to another —
# it would silently stop arriving in real time. REDIS_URL is required when
# NOTIFICATION_TRANSPORT=redis. Set to 'polling' to disable push and fall
# back to client polling instead.
#
# NOTIFICATION_TRANSPORT=sse
# REDIS_URL=redis://localhost:6379
# Optional: heartbeat interval in milliseconds sent on the SSE stream to prevent
# proxy idle-timeout disconnections (default: 25000). Shared with the
# sdk.events SSE stream below — one heartbeat cadence for both.
# NOTIFICATION_HEARTBEAT_INTERVAL=25000

# ── Plugin realtime events (RFC 0045) ────────────────────────────────────────
# Controls how sdk.events delivers realtime channel events. Same shape as
# NOTIFICATION_TRANSPORT above but a separate, independent setting — events
# and notifications scale differently and an operator may want to disable/
# resize one without touching the other. Default is 'sse'. Set to 'redis' for
# multi-process/multi-replica deployments (reuses REDIS_URL, no second
# connection string). Set to 'polling' to disable the SSE stream entirely —
# GET /api/events/stream returns 503 and clients must use
# GET /api/events/poll instead.
#
# SOVEREIGN_EVENTS_TRANSPORT=sse

# ── Plugin scheduler (RFC 0046 Phase 1) ──────────────────────────────────────
# Optional kill-switch. Set to 1 (or true) to stop the runtime from invoking
# plugin-declared background schedules (manifest `schedules`) — e.g. while
# debugging a misbehaving plugin job. Unset = scheduler runs (the default).
# SOVEREIGN_SCHEDULER_DISABLED=1

# ── Plugin job worker (RFC 0046) ─────────────────────────────────────────────
# Optional kill-switch for sdk.jobs' background worker (manifest `jobs`) —
# separate from the scheduler kill-switch above. Set to 1 (or true) to stop
# the runtime from claiming/running queued or scheduled jobs. Unset = the
# worker runs (the default).
# SOVEREIGN_JOB_WORKER_DISABLED=1

# ── Middleware rate limiting ─────────────────────────────────────────────────
# General per-IP request-flood protection covering every path
# runtime/middleware.ts gates (session-gated pages/API, the anonymous public
# /api/<slug>/* namespace, and public plugin page routes) — deliberately
# coarse, a floor against scripted floods, not per-endpoint policy. On by
# default (a security control, so it fails closed). IP is read from the last
# hop of X-Forwarded-For, which assumes the runtime is reachable only through
# the single reverse-proxy hop docs/self-hosting.md documents.
#
# Set to 1 (or true) to disable — e.g. if you already rate-limit at a WAF/CDN
# in front of the instance and don't want this layer doubling up.
# SOVEREIGN_RATE_LIMIT_DISABLED=1
#
# Window and per-IP request ceiling within it. Defaults: 60000 (60s), 300
# requests — generous enough not to trip on normal interactive use (search-
# as-you-type, polling), a floor against naive scripted abuse.
# SOVEREIGN_RATE_LIMIT_WINDOW_MS=60000
# SOVEREIGN_RATE_LIMIT_MAX_REQUESTS=300

# ── Instance identity (RFC 0027 / RFC 0032) ────────────────────────────────────
# Optional. When set, these values are the baseline for the instance.
# Per-instance overrides can be managed in Console → Settings → Instance identity.
# All INSTANCE_* vars are optional — Sovereign defaults apply when unset.
#
# INSTANCE_NAME=Sovereign
# INSTANCE_PRIMARY_COLOR=#000000
# One of: none, xs, s, m, l. Scales every rounded corner (RFC 0077); l is
# large enough that buttons/badges render as full pills. Unset = m (today's look).
# INSTANCE_RADIUS=m
# INSTANCE_LOGO=https://example.com/logo.png
# INSTANCE_LOGO_DARK=https://example.com/logo-dark.png
# INSTANCE_FAVICON=https://example.com/favicon.ico
# INSTANCE_EMAIL_FROM_NAME=Sovereign
# INSTANCE_EMAIL_LOGO=https://example.com/logo-email.png

# ── Example plugins (RFC 0017) ─────────────────────────────────────────────────
# Two layers, one env var:
#   1. Build time — whether example-plugins/ (docs/epics/example-plugins.md)
#      is even composed into the build at all. Off by default: a plain `pnpm
#      build`/`docker build` never ships example routes/code. For a Docker
#      build, this must be passed as a build ARG (docker compose already
#      forwards this same var — see docker-compose.yml's runtime service), not
#      just a runtime env — the published GHCR image ignores it entirely,
#      since it's already built.
#   2. Runtime — for whatever WAS composed, whether it's shown by default:
#      hidden means routes 404 and it never appears in the launcher. An admin
#      can still enable/disable each one (or all) in Console → Plugins
#      regardless of this default, with no rebuild needed.
# Set to 1/true/yes/on for either layer.
#
# SOVEREIGN_EXAMPLES_ENABLED=1

# ── Development plugins ─────────────────────────────────────────────────────────
# Plugins flagged `development: true` in their manifest (not yet production-
# ready) are shown by default, same as any other plugin — just sorted last in
# the sidebar/launcher with an "in development" badge. Set to 1/true/yes/on to
# hide them completely instead: their routes 404 and they never appear in the
# sidebar, launcher, or admin's launcher/sidebar preview. Unlike
# SOVEREIGN_EXAMPLES_ENABLED, this has no per-plugin override and no Console
# toggle — it's a hard, deploy-time gate for pinning an instance to
# production-ready plugins only.
#
# SOVEREIGN_HIDE_DEVELOPMENT_PLUGINS=1
