# Dependencies
node_modules/

# Build output
dist/
# TypeScript project-reference build cache (packages/tsconfig/library.json's
# "composite"/"incremental" — Task 0.14) — a throwaway .d.ts + .tsbuildinfo
# cache for `tsc -b`, deliberately separate from tsup's own "dist/" so
# incremental typechecking can never interfere with the real published output.
dist-tsc/
.next/
.turbo/
# TypeScript incremental build cache (packages/tsconfig/nextjs.json sets
# "incremental": true) — a regenerated artifact, never source. Previously
# only ever produced under gitignored plugins/*/ dirs; example-plugins/ is
# the first non-ignored location that also extends this tsconfig.
*.tsbuildinfo

# Generated plugin route segments are composed under each shell route group
# (e.g. runtime/app/(platform)/(plugins)/) — symlinks in dev, copies in prod.
# A .gitignore inside each group ignores its composed contents. Source of truth
# is always plugins/[id]/app/.

# scripts/generate-registry.ts's output — regenerated by every `pnpm dev`
# startup and by the `pnpm generate` CI step before `pnpm build`. Content is
# a function of whichever plugins happen to be installed in a given checkout
# (community plugins, `.local` dev plugins), so it's inherently
# machine/session-specific — never a meaningful diff to review or commit.
#
# plugin-deps.json (RFC 0057, Task 3.25) is the one deliberate exception:
# unlike everything else in this directory it isn't checkout-specific
# derived output, it's the authoritative record of which committed plugin
# added which runtime dependency — reviewable and meaningful to diff, like
# a lockfile. `runtime/generated/*` (not a trailing-slash directory pattern)
# so the later negation can still see inside the directory; a `dir/` pattern
# would make git refuse to re-include anything under it.
runtime/generated/*
!runtime/generated/plugin-deps.json

# Database files (SQLite) — data/ dirs are created next to each app's cwd
# (root, runtime/, apps/auth/), so match at any depth.
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm

# User-uploaded avatars (Account plugin, ACC-03) — runtime data, never committed.
**/data/avatars/

# Plugin-isolated databases and runtime assets written to data/plugins/ by the
# plugin DB provisioner — runtime data, never committed.
**/data/plugins/

# Externally-installed plugins (cloned by scripts/install-plugins.ts) are not
# committed here — they live in their own repositories. Ignore every plugin
# directory except the platform plugins that ship in this monorepo.
#
# Example plugins are NOT covered by this rule — they live in-repo, tracked in
# git, under example-plugins/ (not plugins/), and are composed into the build
# by scripts/generate-registry.ts when SOVEREIGN_EXAMPLES_ENABLED is set. See
# docs/epics/example-plugins.md's 2026-08-01 correction: this supersedes
# an earlier attempt (Task 12.2) to clone them at build time from a dedicated
# sovereign-plugins-examples repository.
/plugins/*/
!/plugins/account/
!/plugins/console/
!/plugins/launcher/
!/plugins/warden/

# sovereign.plugins.json declares which non-platform plugins get installed
# (epic task 3.31) — a local, per-checkout file, never committed or shared.
# scripts/install-plugins.ts falls back to the committed
# sovereign.plugins.default.json (Tasks-only) when this file doesn't exist.
/sovereign.plugins.json

# PWA service worker + Workbox bundles, generated into runtime/public by
# @ducanh2912/next-pwa at build time. Never committed (the manifest + icons are).
runtime/public/sw.js
runtime/public/sw.js.map
runtime/public/workbox-*.js
runtime/public/workbox-*.js.map
runtime/public/fallback-*.js
runtime/public/worker-*.js

# Environment / secrets
.env
.env.*
!.env.example

# Claude Code — ignore per-machine/local files; shared config (settings.json,
# commands/, agents/) may be committed. launch.json is a local dev-server
# convenience (mirrors `pnpm dev`), kept out of the shared repo.
.claude/settings.local.json
.claude/launch.json
# Ephemeral git worktrees created by spawned/isolated agent tasks — must never
# be tracked or scanned by tooling (format/lint checks would otherwise pick up
# another in-progress session's uncommitted work as if it were part of this one).
.claude/worktrees/

# Claude Code memory — private persistent context for the AI assistant.
# Machine-local; never committed (would conflict across sessions/users).
memory/

# Codex — ignore per-machine/local logs and overrides. Shared repo guidance
# (`AGENTS.md`) and repo skills (`.agents/skills/`) are committed.
.codex-log/
.codex/*.local.*
.codex/AGENTS.override.md

# OS
.DS_Store

# Playwright E2E
playwright-report/
test-results/
.auth/

# Playwright visual regression (RFC 0059) — actual/diff output and reports;
# baseline *-snapshots/ directories are source artifacts and ARE committed.
test-results-visual/
packages/ui/test-results-visual/
playwright-report-visual/
storybook-visual-report/

# Storybook
packages/ui/storybook-static/

# pnpm local store (should live in ~/.local/share/pnpm or equivalent, not the repo)
.pnpm-store/

# Local session working file — never commit
CURRENT_TASK.md
storybook.log
packages/ui/debug-storybook.log
