# Dependencies
node_modules/

# Build output
dist/
.next/
.turbo/
storybook-static/
coverage/
# Regenerated by `next dev` / `next build`; create-next-app's own convention.
next-env.d.ts
# TypeScript incremental build cache — a regenerated artifact, never source.
*.tsbuildinfo

# Local environment and secrets — only .env.example is committed.
.env
.env.*
!.env.example

# Test output
playwright-report/
test-results/

# Runtime data written next to an app's working directory.
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm
/backups/

# The active task (written by /sv-task-start, deleted by /sv-update-task-docs).
CURRENT_TASK.md

# Per-machine agent state.
.claude/settings.local.json
.claude/worktrees/
.remember/

# OS and editor noise
.DS_Store
*.log
.idea/
.vscode/
