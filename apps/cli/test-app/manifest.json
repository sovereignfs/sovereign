{
  "manifest": 1,
  "prefix": "TESTAPP",
  "name": "Test app",
  "description": "Hosted by sv apply's tests",
  "port": 3000,
  "health": "/health",
  "launch": "/",
  "signIn": {
    "redirect": ["/auth/callback"],
    "postLogout": ["/"],
    "backChannel": "/auth/backchannel-logout",
    "accountDeleted": "/auth/account-deleted",
    "scopes": ["openid", "profile", "email"]
  },
  "database": true,
  "generate": ["TESTAPP_AUTH_SECRET"],
  "data": ["/data"],
  "core": ">=0.49.0 <1.0.0"
}
