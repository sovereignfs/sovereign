# Core's environment variables. Copy to `.env.local` for development.
# Rules (the SV_ prefix, the _FILE form for secrets, value syntax): spec/env.md.
# A test keeps this file in step with src/config.ts.

# Core's public address, with no path. It is also the issuer apps sign in against.
SV_URL=http://localhost:3000

# Signs sessions and tokens. At least 32 characters. Generate one with: openssl rand -base64 48
# Alternatively set SV_AUTH_SECRET_FILE to the path of a file holding it (set only one).
SV_AUTH_SECRET=

# The database. Core runs without one for now; when SV_DB_DIALECT is set, its address is
# required and /api/health reports the database up or down.
# One of: sqld, sqlite, postgres. Nothing infers it from an address.
SV_DB_DIALECT=
# sqld: the server's address, its admin address (to create the namespace) and the namespace.
SV_SQLD_URL=
SV_SQLD_ADMIN_URL=
SV_SQLD_NAMESPACE=default
# SQLite: a file: URL, such as file:./data/core.db
SV_SQLITE_URL=
# PostgreSQL: an address, which can carry a password (so SV_POSTGRES_URL_FILE also works).
SV_POSTGRES_URL=
SV_POSTGRES_POOL_MAX=10

# The keys that encrypt stored secrets (an SMTP password, say): id:key entries, newest first,
# comma-separated. A key is 32 random bytes, base64: `openssl rand -base64 32`.
#   SV_FIELD_ENCRYPTION_KEYS=k1:<key>
# To rotate, put a new entry in front and keep the old ones while stored values still use them:
#   SV_FIELD_ENCRYPTION_KEYS=k2:<new key>,k1:<old key>
# Or set SV_FIELD_ENCRYPTION_KEYS_FILE to the path of a file holding the ring (set only one).
# Core does not need it yet; once it is set it must be valid.
SV_FIELD_ENCRYPTION_KEYS=
