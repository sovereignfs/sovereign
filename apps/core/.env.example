# Core's environment variables. Copy to `.env.local` for development.
# Rules (the SV_ prefix, the _FILE form for secrets, value syntax): spec/env.md.
# A test keeps this file in step with src/config.ts.

# Core's public address, with no path. It is also the issuer apps sign in against.
SV_URL=http://localhost:3000

# Signs sessions and tokens. At least 32 characters. Generate one with: openssl rand -base64 48
# Alternatively set SV_AUTH_SECRET_FILE to the path of a file holding it (set only one).
SV_AUTH_SECRET=

# The database. Core cannot run without one (accounts live in it), and applies its migrations
# at start-up. /api/health reports it up or down.
# One of: sqld, sqlite, postgres. Nothing infers it from an address.
SV_DB_DIALECT=
# sqld: the server's address, its admin address (to create the namespace) and the namespace.
SV_SQLD_URL=
SV_SQLD_ADMIN_URL=
SV_SQLD_NAMESPACE=default
# SQLite: a file: URL, such as file:./data/core.db
SV_SQLITE_URL=
# PostgreSQL: an address, which can carry a password (so SV_POSTGRES_URL_FILE also works).
SV_POSTGRES_URL=
SV_POSTGRES_POOL_MAX=10

# The keys that encrypt stored secrets (an SMTP password, say): id:key entries, newest first,
# comma-separated. A key is 32 random bytes, base64: `openssl rand -base64 32`.
#   SV_FIELD_ENCRYPTION_KEYS=k1:<key>
# To rotate, put a new entry in front and keep the old ones while stored values still use them:
#   SV_FIELD_ENCRYPTION_KEYS=k2:<new key>,k1:<old key>
# Or set SV_FIELD_ENCRYPTION_KEYS_FILE to the path of a file holding the ring (set only one).
# Core does not need it yet; once it is set it must be valid.
SV_FIELD_ENCRYPTION_KEYS=

# Sign-in. Extra origins accepted for requests besides SV_URL, comma-separated (rarely needed).
SV_AUTH_TRUSTED_ORIGINS=
# The reverse proxies in front of core (addresses or ranges, comma-separated). Sign-in limits
# count attempts per client address, taken from X-Forwarded-For past these proxies. Without them
# only a single-address header is believed and all other requests share one limit.
SV_AUTH_TRUSTED_PROXIES=
# A parent domain for the session cookie (example.com), so subdomains can share it. It must be
# core's own host or a parent of it. Leave it unset for core's own host only.
SV_AUTH_COOKIE_DOMAIN=
# The password policy, enforced by the server on every request that sets a password.
SV_AUTH_PASSWORD_MIN_LENGTH=8
SV_AUTH_PASSWORD_REQUIRE_UPPERCASE=false
SV_AUTH_PASSWORD_REQUIRE_LOWERCASE=false
SV_AUTH_PASSWORD_REQUIRE_NUMBER=false
SV_AUTH_PASSWORD_REQUIRE_SYMBOL=false

# Block sign-in until the address is verified by a link sent by email (the default). Needs the
# outgoing mail below: with it on and no mail set up, nobody can finish signing up. Set false to
# turn verification off.
SV_AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Defaults the Console can override (a value saved there wins; clearing it returns to these).
# Registration: true means sign-up needs an invite. Unset means true. (The first account is exempt.)
SV_AUTH_INVITE_ONLY=
# Outgoing mail. The password also takes SV_SMTP_PASSWORD_FILE. Set a host and a from address;
# add a user and password if the server needs a login (which then requires TLS). Without them
# core logs a warning at start-up and anything that needs email fails with a clear message.
# For development with a local mail catcher such as Mailpit: host 127.0.0.1, port 1025.
SV_SMTP_HOST=
SV_SMTP_PORT=
SV_SMTP_USER=
SV_SMTP_PASSWORD=
SV_SMTP_FROM=
