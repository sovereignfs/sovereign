{
  "name": "sovereign",
  "version": "0.59.0",
  "private": true,
  "type": "module",
  "description": "Sovereign Core — a self-hostable identity and foundation service, and the shared packages every Sovereign app uses.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "tsx scripts/dev.ts",
    "storybook": "pnpm --filter @sovereignfs/ui storybook",
    "build-storybook": "pnpm --filter @sovereignfs/ui build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "turbo test && vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit",
    "docs:check-links": "tsx scripts/check-doc-links.ts",
    "design:tokens:check": "tsx scripts/design-tokens-check.ts",
    "packages:check": "tsx scripts/check-packages.ts",
    "generate:icons": "tsx scripts/generate-icons.ts && prettier --write packages/ui/src/components/Icon/icons",
    "generate:theme-presets": "tsx scripts/generate-theme-presets-css.ts && prettier --write packages/ui/src/tokens/theme-presets.css",
    "verify:push": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm design:tokens:check && pnpm docs:check-links && pnpm test",
    "prepare": "simple-git-hooks",
    "generate:api-client": "tsx scripts/generate-api-client.ts",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "seed": "tsx apps/core/scripts/seed.ts",
    "e2e": "pnpm --filter @sovereignfs/e2e e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm verify:push"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,json,jsonc,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "lucide": "1.40.0",
    "pg": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
