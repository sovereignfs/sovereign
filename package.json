{
  "name": "sovereign",
  "version": "0.100.0",
  "private": true,
  "type": "module",
  "description": "Sovereign — a modular, self-hostable workspace runtime.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "tsx scripts/ensure-sqld.ts && turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "typecheck:packages:incremental": "tsc -b tsconfig.packages.json",
    "typecheck:packages:incremental:clean": "tsc -b tsconfig.packages.json --clean",
    "design:tokens:check": "tsx scripts/design-tokens-check.ts",
    "docs:check-links": "tsx scripts/check-doc-links.ts",
    "verify:push": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm design:tokens:check && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run __tests__/integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:visual": "pnpm --filter @sovereignfs/ui test:visual && playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "pnpm --filter @sovereignfs/ui test:visual:update && playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:all": "vitest run && vitest run __tests__/integration --passWithNoTests && playwright test",
    "kill-port": "bash -c 'for port in 3000 3001; do pid=$(lsof -nP -iTCP:$port -sTCP:LISTEN 2>/dev/null | grep LISTEN | awk \"{print \\$2}\" | head -1); if [ -n \"$pid\" ]; then kill -9 $pid && echo \"Port $port freed (PID $pid)\"; else echo \"Port $port is already free\"; fi; done'",
    "generate": "tsx scripts/generate-registry.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:splash": "tsx scripts/generate-splash.ts",
    "generate:theme-presets": "tsx scripts/generate-theme-presets-css.ts",
    "install:plugins": "tsx scripts/install-plugins.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "registry:check": "tsx scripts/validate-registry.ts --check",
    "validate:plugin-boundary": "tsx scripts/validate-plugin-boundary.ts",
    "sv": "tsx bin/sv.ts",
    "storybook": "pnpm --filter @sovereignfs/ui storybook",
    "build-storybook": "pnpm --filter @sovereignfs/ui build-storybook",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm validate:plugin-boundary",
    "pre-push": "pnpm verify:push"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,json,jsonc,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "catalog:",
    "@sovereignfs/db": "workspace:*",
    "@sovereignfs/manifest": "workspace:*",
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "better-auth": "^1.6.25",
    "better-sqlite3-multiple-ciphers": "catalog:",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "lucide": "1.28.0",
    "prettier": "^3.9.6",
    "semver": "catalog:",
    "sharp": "0.35.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
