{
  "name": "@sovereignfs/auth",
  "version": "0.2.0",
  "private": true,
  "description": "How core and every Sovereign app sign people in: core's own sign-in, the part of it that is not about core.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/browser.js"
  ],
  "engines": {
    "node": ">=22.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/next/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "@sovereignfs/config": "workspace:*",
    "@sovereignfs/crypto": "workspace:*",
    "@sovereignfs/database": "workspace:*",
    "@sovereignfs/sdk": "workspace:*",
    "better-auth": "1.7.18",
    "drizzle-orm": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
