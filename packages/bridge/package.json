{
  "name": "@sovereignfs/bridge",
  "version": "0.2.1",
  "type": "module",
  "description": "Sovereign device bridge — capability negotiation between an app's pages and a native shell (Capacitor/Tauri), with a browser fallback.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/sovereign-core.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/sovereignfs/sovereign-core/tree/main/packages/bridge#readme",
  "bugs": {
    "url": "https://github.com/sovereignfs/sovereign-core/issues"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./shell": {
        "types": "./dist/shell.d.ts",
        "default": "./dist/shell.js"
      }
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
