{
  "name": "@sovereignfs/config",
  "version": "0.1.0",
  "description": "The environment variable convention for Sovereign core and apps: declare, read and validate settings with a per-app prefix.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/sovereign.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/sovereignfs/sovereign/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/sovereignfs/sovereign/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
