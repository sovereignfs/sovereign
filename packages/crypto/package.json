{
  "name": "@sovereignfs/crypto",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Encryption for Sovereign: field encryption on the server, the keys of RFC 0005 in a browser (`/web`), and the vault of an app with no core (`/vault`).",
  "license": "MPL-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./vault": {
      "types": "./dist/vault/index.d.ts",
      "default": "./dist/vault/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p timing",
    "vectors": "tsx scripts/password-vectors.ts",
    "timing": "tsx scripts/timing.ts",
    "vectors:formats": "tsx scripts/format-vectors.ts"
  },
  "dependencies": {
    "@sovereignfs/config": "workspace:*",
    "libsodium-wrappers-sumo": "catalog:"
  },
  "devDependencies": {
    "@hpke/core": "catalog:",
    "@noble/hashes": "catalog:",
    "@sovereignfs/database": "workspace:*",
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
