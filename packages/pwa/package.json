{
  "name": "@sovereignfs/pwa",
  "version": "0.3.0",
  "description": "What makes a Sovereign app installable: its manifest, a service worker that keeps nothing of a person, and an announced update.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/sovereign.git",
    "directory": "packages/pwa"
  },
  "homepage": "https://github.com/sovereignfs/sovereign/tree/main/packages/pwa#readme",
  "bugs": {
    "url": "https://github.com/sovereignfs/sovereign/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sovereignfs/ui": ">=0.100.0 <1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@sovereignfs/tsconfig": "workspace:*",
    "@sovereignfs/ui": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
