{
  "name": "@sovereignfs/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "How a JavaScript app's server talks to the Sovereign server it signs people in with: tokens, failure, version support.",
  "license": "MPL-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/sovereign.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sovereignfs/sovereign/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/sovereignfs/sovereign/issues"
  },
  "exports": {
    ".": {
      "browser": "./src/browser.ts",
      "default": "./src/index.ts"
    },
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sovereignfs/api-client": "workspace:*",
    "@sovereignfs/config": "workspace:*"
  },
  "devDependencies": {
    "@sovereignfs/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
