# What the instance gives this app (spec/app-manifest.md §3), for running it on your own machine against a core you can reach.
# A secret may be given as NAME_FILE=/path instead of NAME=value.
__PREFIX___URL=http://localhost:3000
__PREFIX___CORE_URL=https://core.sovereign.local
__PREFIX___CORE_CLIENT_ID=
__PREFIX___CORE_CLIENT_SECRET=
__PREFIX___DB_DIALECT=postgres
__PREFIX___POSTGRES_URL=postgres://user:password@localhost:5432/__NAME__
__PREFIX___AUTH_SECRET=change-me-to-something-long-and-random
