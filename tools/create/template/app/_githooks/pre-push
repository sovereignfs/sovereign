#!/bin/sh
# Checks the work before it is pushed (CONTRIBUTING.md, "Continuous integration"): CI does not run for `develop` or a feature branch,
# so this is their check. `__INSTALL__` turns it on (a script in package.json sets core.hooksPath to .githooks). Skip it once, knowingly,
# with `git push --no-verify`.
exec __RUN__ verify
