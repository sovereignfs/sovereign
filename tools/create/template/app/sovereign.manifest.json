{
  "manifest": 3,
  "prefix": "__PREFIX_LOWER__",
  "name": "__TITLE__",
  "description": "Notes, as a starting point for an app on a Sovereign instance",
  "port": 3100,
  "health": "/api/health",
  "icon": "/pwa-icon/192",
  "launch": "/",
  "signIn": {
    "redirect": ["/api/auth/callback/sovereign"],
    "postLogout": ["/sign-in"],
    "backChannel": "/api/sovereign/backchannel-logout",
    "accountDeleted": "/api/sovereign/account-deleted",
    "scopes": ["openid", "profile", "email", "offline_access"]
  },
  "database": {
    "pooling": "transaction"
  },
  "storage": true,
  "generate": ["__PREFIX___AUTH_SECRET"],
  "core": ">=0.49.0 <1.0.0"
}
