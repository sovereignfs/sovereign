{
  "manifest": 5,
  "prefix": "__PREFIX_LOWER__",
  "name": "__TITLE__",
  "description": "Notes kept encrypted in the browser, as a starting point for an app on a Sovereign instance",
  "port": 3100,
  "health": "/api/health",
  "icon": "/pwa-icon/192",
  "launch": "/",
  "signIn": {
    "redirect": ["/api/auth/callback/sovereign"],
    "postLogout": ["/sign-in"],
    "backChannel": "/api/sovereign/backchannel-logout",
    "accountDeleted": "/api/sovereign/account-deleted",
    "export": "/api/sovereign/export",
    "scopes": ["openid", "profile", "email", "offline_access", "directory"]
  },
  "encryption": {
    "return": "/keys/return"
  },
  "database": {
    "pooling": "transaction"
  },
  "storage": true,
  "generate": [
    "__PREFIX___AUTH_SECRET",
    {
      "name": "__PREFIX___VAPID_PRIVATE_KEY",
      "bytes": 32
    }
  ],
  "core": ">=0.126.0 <1.0.0"
}
